# ── Credenciais da API do Kaggle ─────────────────────────────────────────────
# Obtenha estas informações em: https://www.kaggle.com/settings
# Clique em "Create New API Token" para baixar o arquivo kaggle.json
KAGGLE_USERNAME=seu_usuario_aqui
KAGGLE_KEY=sua_chave_api_aqui

# ── Configurações de MLOps (Opcional) ─────────────────────────────────────────
# Caso queira centralizar a URI do MLflow aqui em vez de no YAML
MLFLOW_TRACKING_URI=sqlite:///mlruns.db